{
	"name": "kotoba",
	"license": "MIT",
	"version": "0.1.0",
	"private": true,
	"description": "The Japanese lookup yomu and tsundoku share: kuromoji tokenizing, JMdict, furigana, romaji.",
	"type": "module",
	"packageManager": "yarn@1.22.22",
	"exports": {
		".": "./src/index.ts",
		"./server": "./src/server/index.ts"
	},
	"bin": {
		"kotoba-sync-dict": "./scripts/sync-dict.js",
		"kotoba-build-dict": "./scripts/build-dict.js"
	},
	"scripts": {
		"check": "tsc --noEmit",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"build:dict": "node scripts/build-dict.js",
		"test:coverage": "vitest run --coverage",
		"hooks:check": "node scripts/hooks-armed.mjs",
		"lint-staged": "lint-staged",
		"prepare": "husky || true"
	},
	"dependencies": {
		"@patdx/kuromoji": "^1.0.4",
		"better-sqlite3": "^12.11.1"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^24",
		"@vitest/coverage-v8": "^4.1.11",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.6.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"prettier": "^3.8.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	},
	"engines": {
		"node": ">=24"
	}
}
